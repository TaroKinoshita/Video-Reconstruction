__pycache__/
*.pyc
.venv/
.env
*.blend1
# large / generated media (keep configs and manifests, not raw video)
evaluation/clips/*
!evaluation/clips/.gitkeep
!evaluation/clips/manifest.json
runs/*
!runs/.gitkeep
*.mp4
*.mov
*.exr
*.egg-info/
.pytest_cache/
# phase 1a: control videos (small) travel through git to the GPU machine; passes and previews stay local
!evaluation/phase1a/controls/*/control_*.mp4
evaluation/phase1a/controls/*/passes/
evaluation/phase1a/controls/*/preview/
# GPU machine
third_party/
models/
# synthetic ground-truth clips: video, gt.json, meta.json are small and shared; passes are regenerated
!evaluation/synthetic/*/video.mp4
evaluation/synthetic/*/gt_passes/
!evaluation/synthetic2d/*/video.mp4
evaluation/synthetic2d/*/gt_passes/
evaluation/completion/*/gt_passes/
evaluation/venue/*/gt_passes/
evaluation/venue/*/observed.npz
