{
 "about": "Tennis, observation -> finished scene (docs/HANDOFF_EN.md section 6, review F-02/F-03). Executable from the start: `vrecon pipeline-scene evaluation/recipes/tennis/scene.json [--check]` runs the 'run' list into a new work folder and compares each stage with the stored results. The stages after 'venue' (complete, timing, props, status) are still listed in 'stages' as scripts. Every per-clip value carries its basis.",
 "inputs": {
  "video": {
   "path": "runs/human/tennis/tennis.mp4",
   "basis": "observation: the clip shipped with GVHMR (D8: research use, not published)"
  },
  "masks": {
   "path": "runs/human/tennis/masks.npz",
   "tool": "SAM 3.1 f1647e8 (gpu/observe/run_sam3.py)"
  },
  "floor_masks": {
   "path": "runs/human/tennis/floor_masks.npz",
   "tool": "SAM 3.1 on ComfyUI (gpu/h3_control/comfy_sam.py --prompt 'floor, ground, tennis court')"
  },
  "start_scene_4d": {
   "path": "runs/human/tennis/4rc.npz",
   "tool": "4RC a08ca0a"
  },
  "skeleton": {
   "path": "runs/human/tennis/gvhmr_skeleton.npz",
   "tool": "GVHMR ee960bb (WSL) + gpu/observe/gvhmr_body_mesh.py"
  },
  "props_masks": {
   "path": "runs/human/tennis/props_masks.npz",
   "tool": "SAM 3.1 per window (scripts/props_recut.py)"
  },
  "ball_masks": {
   "path": "runs/human/tennis/recut/ball_masks.npz",
   "tool": "scripts/props_recut.py merge"
  },
  "skeleton_left": {
   "path": "runs/human/tennis/left/gvhmr_skeleton.npz",
   "tool": "GVHMR ee960bb on the left-side person (WSL)"
  },
  "venue_layout": {
   "path": "runs/venue/tennis/fal2c/layout.json",
   "tool": "recorded LLM answer (scripts/llm_venue.py with fal outside pictures); not re-run"
  },
  "after": {
   "path": "runs/venue/tennis/tennis_after.json",
   "tool": "human hypothesis (rules of tennis), recorded"
  }
 },
 "values": {
  "focal_px": {
   "value": 2104,
   "basis": "measured: court line calibration (scripts/calibrate_court.py), fixed afterwards"
  },
  "court_template": {
   "value": "ITF singles/doubles court 10.97 x 23.77 m, net 12.8 x 1.07 m",
   "basis": "standard: ITF rules"
  },
  "units_per_metre": {
   "value": 1.0,
   "basis": "measured: court lines (units.json)"
  },
  "person_main": {
   "value": "obj_person_01",
   "basis": "observation: GVHMR on the server"
  },
  "proxy_kinds": {
   "value": {
    "obj_net": "board"
   },
   "basis": "human (scripts/proxies_scene.py --kinds)"
  },
  "stands_rise_m": {
   "value": 0.45,
   "basis": "default: typical stand row rise"
  },
  "crowd_density": {
   "value": 0.08,
   "basis": "llm: venue layout answer, kept from fal2c"
  },
  "venue_layout": {
   "path": "runs/venue/tennis/fal2c/layout.json",
   "basis": "llm: claude -p over the observation summary (scripts/llm_venue.py)"
  },
  "after_strike": {
   "path": "runs/venue/tennis/tennis_after.json",
   "value": {
    "target_m": [
     2.0,
     5.8,
     0.03
    ],
    "speed_mps": 45
   },
   "basis": "human: a serve into the service box (rules of tennis, typical speed)"
  },
  "prop_link_px": {
   "value": 180,
   "basis": "default: tracklet link distance (scripts/fit_props.py --link)"
  },
  "hand_px": {
   "value": 35,
   "basis": "default (scripts/fit_props.py --hand-px)"
  },
  "moves": {
   "value": "source,dolly-100+crane4,orbit90+dolly-60,orbit180,crane10",
   "basis": "human: the camera moves asked for (stored controls_* folders)"
  }
 },
 "stages": [
  {
   "stage": "calibrate",
   "command": "scripts/calibrate_court.py",
   "output": "court frame, focal, units.json"
  },
  {
   "stage": "to_court",
   "command": "analysis/to_court.py (via scripts)",
   "output": "4RC points on the calibrated rays"
  },
  {
   "stage": "people",
   "command": "scripts/place_person.py; scripts/proxies_scene.py",
   "output": "GVHMR person on scene rays, other people as figures, clothing colours"
  },
  {
   "stage": "venue",
   "command": "scripts/observe_venue.py -> scripts/llm_venue.py -> scripts/build_venue.py",
   "output": "runs/venue/tennis/fal2c"
  },
  {
   "stage": "complete",
   "command": "scripts/complete_scene.py",
   "output": "unseen space filled, source view protected"
  },
  {
   "stage": "timing",
   "command": "vrecon run align_timing / hold_still",
   "output": "keys on observed onsets"
  },
  {
   "stage": "props",
   "command": "scripts/fit_props.py ... --after tennis_after.json --link 180",
   "output": "runs/venue/tennis/fal2c_props (racket, ball with status spans)"
  },
  {
   "stage": "status",
   "command": "scripts/convert_tennis_status.py",
   "output": "runs/venue/tennis/status_v040 (schema 0.4.0 statuses, scale filled)"
  },
  {
   "stage": "v2v",
   "command": "vrecon pipeline-v2v evaluation/recipes/tennis/v2v.json",
   "output": "shapes, floor check, clay references, crops, prompts, generation"
  }
 ],
 "work": "runs/recipes/tennis_scene",
 "run": [
  {
   "stage": "calibrate",
   "argv": [
    "{python}",
    "scripts/calibrate_court.py",
    "{in:video}",
    "{in:masks}",
    "{work}/court"
   ],
   "outputs": [
    "{work}/court/calibration.json"
   ],
   "stored": {
    "{work}/court/calibration.json": "runs/human/tennis/court/calibration.json"
   }
  },
  {
   "stage": "person",
   "argv": [
    "{python}",
    "scripts/place_person.py",
    "{in:video}",
    "{in:skeleton}",
    "{in:start_scene_4d}",
    "{work}/scene"
   ],
   "outputs": [
    "{work}/scene/project.json"
   ],
   "stored": {
    "{work}/scene/project.json": "runs/human/tennis/scene/project.json"
   }
  },
  {
   "stage": "proxies",
   "argv": [
    "{python}",
    "scripts/proxies_scene.py",
    "{in:video}",
    "{in:start_scene_4d}",
    "{in:masks}",
    "{work}/scene",
    "{work}/court_proxies",
    "--person",
    "obs_1={in:skeleton_left}",
    "--calibration",
    "{work}/court/calibration.json"
   ],
   "outputs": [
    "{work}/court_proxies/project.json"
   ],
   "stored": {
    "{work}/court_proxies/project.json": "runs/human/tennis/court_proxies/project.json"
   }
  },
  {
   "stage": "observe",
   "argv": [
    "{python}",
    "scripts/observe_venue.py",
    "tennis",
    "{in:video}",
    "{in:start_scene_4d}",
    "{in:masks}",
    "{work}/scene",
    "{work}/court/calibration.json",
    "{work}/observations.json"
   ],
   "outputs": [
    "{work}/observations.json"
   ],
   "stored": {
    "{work}/observations.json": "runs/venue/tennis/observations.json"
   }
  },
  {
   "stage": "venue",
   "argv": [
    "{python}",
    "scripts/build_venue.py",
    "{in:venue_layout}",
    "{work}/observations.json",
    "{work}/venue",
    "--tennis",
    "{work}/court_proxies"
   ],
   "outputs": [
    "{work}/venue/project.json"
   ],
   "stored": {
    "{work}/venue/project.json": "runs/venue/tennis/fal2c/project.json"
   }
  },
  {
   "stage": "props",
   "argv": [
    "{python}",
    "scripts/fit_props.py",
    "{work}/venue/project.json",
    "{in:video}",
    "{work}/props",
    "--prop",
    "tennis racket={in:props_masks}:obs_0",
    "--prop",
    "tennis ball={in:ball_masks}",
    "--one",
    "tennis ball",
    "--after",
    "{in:after}",
    "--link",
    "{val:prop_link_px}"
   ],
   "outputs": [
    "{work}/props/project.json"
   ],
   "stored": {
    "{work}/props/project.json": "runs/venue/tennis/fal2c_props/project.json",
    "{work}/props/props.json": "runs/venue/tennis/fal2c_props/props.json"
   }
  },
  {
   "stage": "export",
   "argv": [
    "{python}",
    "scripts/export_scene_controls.py",
    "{work}/props/project.json",
    "{work}/props",
    "{work}/props/final",
    "--moves",
    "{val:moves}",
    "--rise-m",
    "{val:stands_rise_m}"
   ],
   "outputs": [
    "{work}/props/final/project.json"
   ],
   "stored": {
    "{work}/props/final/project.json": "runs/venue/tennis/fal2c_props/final/project.json"
   }
  },
  {
   "stage": "status",
   "argv": [
    "{python}",
    "scripts/convert_tennis_status.py",
    "--final",
    "{work}/props/final",
    "--props",
    "{work}/props/props.json",
    "--out",
    "{work}/status"
   ],
   "outputs": [
    "{work}/status/project.json"
   ],
   "stored": {
    "{work}/status/project.json": "runs/venue/tennis/status_v040/project.json"
   }
  }
 ],
 "rebuild_check_2026_11_18": {
  "calibrate": "same",
  "person": "max difference 0.0086 (schema 0.3.0 stored, migrated)",
  "proxies": "same (court-frame scene)",
